@model IEnumerable<MyMvcApp.Models.Note>




@{
    ViewData["Title"] = "All Notes";
}



@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
        <span>✓</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}










<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            All Notes
        </h2>

        <p class="text-muted mb-0">
            View and manage all your notes.
        </p>
    </div>

    <!-- Main Action -->
    <a 
        asp-controller="Dashboard"
        asp-action="CreateNote"
        class="btn btn-primary"
    >
        + New Note
    </a>

</div>










<!-- Search -->
<form 
    asp-controller="Dashboard"
    asp-action="AllNotes"
    method="get"
    class="mb-4"
>
    <input type="text"
           class="form-control form-control-lg"
           placeholder="🔍 Search your notes..." 
           name="search"
           value="@ViewData["Search"]"
    />
</form>










<!-- Notes -->
@if (!Model.Any())
{
    <div class="text-center py-5 border rounded bg-light">

        <div style="font-size: 45px;">
            📝
        </div>

        <h5 class="mt-3">
            No notes yet
        </h5>

        <p class="text-muted mb-3">
            Create your first note to get started.
        </p>

        <a 
            asp-controller="Dashboard"
            asp-action="CreateNote"
            class="btn btn-primary"
        >
            + Create Note
        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var note in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-2">

                            <h5 class="fw-bold mb-4">
                                @note.Title
                            </h5>

                            @if (note.IsPinned)
                            {
                                <span>📌</span>
                            }

                        </div>

                        <p class="text-muted d-block mb-4">
                            @note.Content
                        </p>

                        <small class="text-muted d-block mb-3">
                            Updated:
                            @note.UpdatedAt.ToString("MMMM d, yyyy")
                        </small>

                    </div>




                    <div class="card-footer bg-white border-0">

                        <div class="d-flex gap-2">

                            <a 
                                class="btn btn-sm btn-outline-primary"
                                asp-controller="Dashboard"
                                asp-action="EditNote"
                                asp-route-id="@note.Id" 
                                asp-route-returnAction="AllNotes" 
                                @* For Example:   /Dashboard/EditNote/7 *@
                            >
                                Edit
                            </a>





                            <form 
                                asp-controller="Dashboard"
                                asp-action="TogglePin"
                                asp-route-id="@note.Id"
                                method="post"
                                asp-route-returnAction="AllNotes"
                                class="d-inline"
                            >
                                <button type="submit"
                                    class="btn btn-sm btn-outline-secondary">
                                    @(note.IsPinned ? "Unpin" : "Pin")
                                </button>

                            </form>






                            <form 
                                asp-controller="Dashboard"
                                asp-action="DeleteNote"
                                asp-route-id="@note.Id"
                                asp-route-returnAction="AllNotes"
                                method="post"
                                class="d-inline">

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>



                </div>

            </div>
        }

    </div>
}

