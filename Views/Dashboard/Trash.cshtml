@model IEnumerable<MyMvcApp.Models.Note>




@{
    ViewData["Title"] = "Trash";
}


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
        <span>✓</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}








<div class="mb-4">
    <h2 class="fw-bold mb-1">Trash</h2>

    <p class="text-muted mb-0">
        Notes you've deleted are kept here.
    </p>
</div>




@if (!Model.Any())
{
    <div class="text-center py-5 border rounded bg-light">

        <div style="font-size: 45px;">
            🗑️
        </div>

        <h5 class="mt-3">
            Trash is empty
        </h5>

        <p class="text-muted mb-0">
            Deleted notes will appear here.
        </p>

    </div>
}


else
{
    <div class="row g-4">

        @foreach (var note in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body">

                        <h5 class="fw-bold mb-2">
                            @note.Title
                        </h5>

                        <p class="text-muted">
                            @note.Content
                        </p>

                        <small class="text-muted">
                            Deleted: @note.UpdatedAt.ToString("MMMM d, yyyy")
                        </small>

                    </div>





                    <div class="card-footer bg-white border-0 d-flex justify-content-between gap-2">

                        <form 
                            asp-controller="Dashboard"
                            asp-action="RestoreNote"
                            asp-route-id="@note.Id"
                            method="post"
                            class="d-inline"
                        >
                            <button type="submit"
                                    class="btn btn-sm btn-outline-primary">
                                Restore
                            </button>

                        </form>


                        <button 
                            type="button"
                            class="btn btn-sm btn-outline-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal-@note.Id"
                        >
                            Delete Permanently
                        </button>                   


                    </div>

                </div>

            </div>







            @* Permanent Delete ?? *@
            @* Are You Sure ??  *@
            <div class="modal fade"
                id="deleteModal-@note.Id"
                tabindex="-1"
                aria-hidden="true"
            >

                <div class="modal-dialog modal-dialog-centered">



                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">
                                Delete note?
                            </h5>

                            <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                            </button>
                        </div>




                        <div class="modal-body">
                            <p class="mb-1">
                                Are you sure you want to permanently delete
                                <strong>@note.Title</strong>?
                            </p>

                            <p class="text-muted mb-0">
                                This action cannot be undone.
                            </p>
                        </div>





                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal"
                            >
                                Cancel
                            </button>

                            <form 
                                asp-controller="Dashboard"
                                asp-action="DeletePermanently"
                                asp-route-id="@note.Id"
                                method="post"
                                class="d-inline"
                            >

                                <button type="submit"
                                        class="btn btn-danger"
                                >
                                    Delete Permanently
                                </button>

                            </form>

                        </div>

                    </div>

                </div>


            </div>



        }















    </div>
}