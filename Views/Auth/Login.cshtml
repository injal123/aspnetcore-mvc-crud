@using MyMvcApp.Dto

@model LoginUserDto 





@* Acc Created Successfully. Pls Log in ----  msg from CreateUser() *@
@* "You have been logged out successfully." --- msg from Logout() *@

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
        <span>✓</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}








<form 
    class="container mt-5" style="max-width: 400px;"
    method="post"
    asp-controller="Auth" asp-action="LoginUser"
>


    <h2 class="text-center mb-4">Login</h2>



    @*  ⚠️⚠️  Form/model-level error: from - - - -  string.Empty *@
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>


    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input 
            type="email" 
            class="form-control"
            placeholder="Enter your email"
            asp-for="Email"
        >
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>



    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <input type="password" 
            class="form-control"
            placeholder="Enter your password"
            asp-for="Password"
        >
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>



    <button type="submit" class="btn btn-primary w-100">
        Login
    </button>




    <div class="text-center mt-3">
        <span>New User?</span>

        @* <a href="/Auth/Register">
            Register Here...
        </a> *@

        <a asp-controller="Auth" asp-action="Register">
            Register Here
        </a>

    </div>

</form>






@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}